<!DOCTYPE html>
<html>
<head>
    <title>Results</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('header') %>

    <div class="container">
        <div class="row">
            <% drinks.forEach(d => { %>
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <img src="<%= d.strDrinkThumb %>" class="card-img-top" alt="<%= d.strDrink %>">
                        <div class="card-body">
                            <h3><%= d.strDrink %></h3>
                            <p><%= d.strInstructions %></p>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        <a href="/" class="btn btn-secondary mb-4">Search again</a>
    </div>
</body>
</html>
